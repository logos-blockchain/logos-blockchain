# Environment variables for compose.yml file config.
#
# Fields are grouped by how often they change. See deployment/README.md
# ("Release & deployment file taxonomy") for the full picture.

DOCKER_COMPOSE_LIBP2P_REPLICAS=1
TOOLS_IMAGE_LABEL=example

# === PER-RELEASE: edit on every release ===

# Node version being released.
NODE_IMAGE_LABEL=X.Y.Z
